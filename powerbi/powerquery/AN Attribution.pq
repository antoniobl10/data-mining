let Source = AnalyticsCsv("mart_marketing_attribution.csv", {"channel", "campaign", "attributed_cost", "attributed_conversions", "attributed_value", "attribution_model", "attribution_window_days", "roi_proxy", "synthetic_data_flag", "data_origin"}, {{"channel", type text}, {"campaign", type text}, {"attributed_cost", type number}, {"attributed_conversions", type number}, {"attributed_value", type number}, {"attribution_model", type text}, {"attribution_window_days", Int64.Type}, {"roi_proxy", type number}, {"synthetic_data_flag", type logical}, {"data_origin", type text}}), Renamed = Table.RenameColumns(Source, {{"channel", "Channel"}, {"campaign", "Campaign"}, {"attributed_cost", "Attributed Cost"}, {"attributed_conversions", "Attributed Conversions"}, {"attributed_value", "Attributed Value"}, {"attribution_model", "Attribution Model"}, {"attribution_window_days", "Attribution Window Days"}, {"roi_proxy", "Roi Proxy"}, {"synthetic_data_flag", "Synthetic Data Flag"}, {"data_origin", "Data Origin"}}) in Renamed
