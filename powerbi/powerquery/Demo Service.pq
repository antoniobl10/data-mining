let Source = SyntheticCsv("dim_service.csv", {"service_name", "service_key", "service_category", "synthetic_data_flag", "data_origin"}, {{"service_name", type text}, {"service_key", Int64.Type}, {"service_category", type text}, {"synthetic_data_flag", type logical}, {"data_origin", type text}}), Renamed = Table.RenameColumns(Source, {{"service_name", "Service Name"}, {"service_key", "Service Key"}, {"service_category", "Service Category"}, {"synthetic_data_flag", "Synthetic Data Flag"}, {"data_origin", "Data Origin"}}) in Renamed
