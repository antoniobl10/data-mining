let Source = AnalyticsCsv("mart_campaign_economics.csv", {"campaign_id", "channel", "campaign_type", "contacts", "opens", "clicks", "conversions", "campaign_cost", "gross_value_proxy", "median_time_to_conversion", "average_time_to_conversion", "open_rate", "ctr", "conversion_rate", "cost_per_conversion", "roi_proxy", "synthetic_data_flag", "data_origin"}, {{"campaign_id", type text}, {"channel", type text}, {"campaign_type", type text}, {"contacts", Int64.Type}, {"opens", Int64.Type}, {"clicks", Int64.Type}, {"conversions", Int64.Type}, {"campaign_cost", type number}, {"gross_value_proxy", type number}, {"median_time_to_conversion", type number}, {"average_time_to_conversion", type number}, {"open_rate", type number}, {"ctr", type number}, {"conversion_rate", type number}, {"cost_per_conversion", type number}, {"roi_proxy", type number}, {"synthetic_data_flag", type logical}, {"data_origin", type text}}), Renamed = Table.RenameColumns(Source, {{"campaign_id", "Campaign Id"}, {"channel", "Channel"}, {"campaign_type", "Campaign Type"}, {"contacts", "Contacts"}, {"opens", "Opens"}, {"clicks", "Clicks"}, {"conversions", "Conversions"}, {"campaign_cost", "Campaign Cost"}, {"gross_value_proxy", "Gross Value Proxy"}, {"median_time_to_conversion", "Median Time To Conversion"}, {"average_time_to_conversion", "Average Time To Conversion"}, {"open_rate", "Open Rate"}, {"ctr", "Ctr"}, {"conversion_rate", "Conversion Rate"}, {"cost_per_conversion", "Cost Per Conversion"}, {"roi_proxy", "Roi Proxy"}, {"synthetic_data_flag", "Synthetic Data Flag"}, {"data_origin", "Data Origin"}}) in Renamed
