let Source = AnalyticsCsv("mart_growth_summary.csv", {"customers", "likely_primary_bank_rate", "salary_domiciliation_rate", "service_activation_rate", "nps", "high_value_low_engagement_customers", "high_value_low_engagement_balance_share", "observed_campaign_roi_proxy", "synthetic_data_flag", "data_origin"}, {{"customers", Int64.Type}, {"likely_primary_bank_rate", type number}, {"salary_domiciliation_rate", type number}, {"service_activation_rate", type number}, {"nps", type number}, {"high_value_low_engagement_customers", Int64.Type}, {"high_value_low_engagement_balance_share", type number}, {"observed_campaign_roi_proxy", type number}, {"synthetic_data_flag", type logical}, {"data_origin", type text}}), Renamed = Table.RenameColumns(Source, {{"customers", "Customers"}, {"likely_primary_bank_rate", "Likely Primary Bank Rate"}, {"salary_domiciliation_rate", "Salary Domiciliation Rate"}, {"service_activation_rate", "Service Activation Rate"}, {"nps", "Nps"}, {"high_value_low_engagement_customers", "High Value Low Engagement Customers"}, {"high_value_low_engagement_balance_share", "High Value Low Engagement Balance Share"}, {"observed_campaign_roi_proxy", "Observed Campaign Roi Proxy"}, {"synthetic_data_flag", "Synthetic Data Flag"}, {"data_origin", "Data Origin"}}) in Renamed
