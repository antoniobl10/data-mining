let Source = AnalyticsCsv("mart_lifecycle_summary.csv", {"prediction_date", "lifecycle_stage", "customers", "average_engagement", "synthetic_data_flag", "data_origin"}, {{"prediction_date", type datetime}, {"lifecycle_stage", type text}, {"customers", Int64.Type}, {"average_engagement", type number}, {"synthetic_data_flag", type logical}, {"data_origin", type text}}), Renamed = Table.RenameColumns(Source, {{"prediction_date", "Prediction Date"}, {"lifecycle_stage", "Lifecycle Stage"}, {"customers", "Customers"}, {"average_engagement", "Average Engagement"}, {"synthetic_data_flag", "Synthetic Data Flag"}, {"data_origin", "Data Origin"}}) in Renamed
