let Source = MLCsv("model_performance.csv", {"use_case", "model_name", "model_version", "evaluation_type", "data_origin", "roc_auc", "pr_auc", "precision", "recall", "f1", "log_loss", "brier_score", "lift_at_10", "recall_at_top_5", "recall_at_top_10", "calibration", "test_start", "test_end"}, {{"use_case", type text}, {"model_name", type text}, {"model_version", type text}, {"evaluation_type", type text}, {"data_origin", type text}, {"roc_auc", type number}, {"pr_auc", type number}, {"precision", type number}, {"recall", type number}, {"f1", type number}, {"log_loss", type number}, {"brier_score", type number}, {"lift_at_10", type number}, {"recall_at_top_5", type number}, {"recall_at_top_10", type number}, {"calibration", type text}, {"test_start", type text}, {"test_end", type text}}), Renamed = Table.RenameColumns(Source, {{"use_case", "Use Case"}, {"model_name", "Model Name"}, {"model_version", "Model Version"}, {"evaluation_type", "Evaluation Type"}, {"data_origin", "Data Origin"}, {"roc_auc", "Roc Auc"}, {"pr_auc", "Pr Auc"}, {"precision", "Precision"}, {"recall", "Recall"}, {"f1", "F1"}, {"log_loss", "Log Loss"}, {"brier_score", "Brier Score"}, {"lift_at_10", "Lift At 10"}, {"recall_at_top_5", "Recall At Top 5"}, {"recall_at_top_10", "Recall At Top 10"}, {"calibration", "Calibration"}, {"test_start", "Test Start"}, {"test_end", "Test End"}}) in Renamed
