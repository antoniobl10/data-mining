let Source = SyntheticCsv("fact_digital_events.csv", {"interaction_id", "customer_id", "event_timestamp", "channel", "event_type", "session_id", "device_type", "feature_name", "synthetic_data_flag", "data_origin", "customer_key", "date_key", "month", "login_flag", "mobile_flag"}, {{"interaction_id", type text}, {"customer_id", type text}, {"event_timestamp", type datetime}, {"channel", type text}, {"event_type", type text}, {"session_id", type text}, {"device_type", type text}, {"feature_name", type text}, {"synthetic_data_flag", type logical}, {"data_origin", type text}, {"customer_key", Int64.Type}, {"date_key", Int64.Type}, {"month", type text}, {"login_flag", type logical}, {"mobile_flag", type logical}}), Renamed = Table.RenameColumns(Source, {{"interaction_id", "Interaction Id"}, {"customer_id", "Customer ID"}, {"event_timestamp", "Event Timestamp"}, {"channel", "Channel"}, {"event_type", "Event Type"}, {"session_id", "Session Id"}, {"device_type", "Device Type"}, {"feature_name", "Feature Name"}, {"synthetic_data_flag", "Synthetic Data Flag"}, {"data_origin", "Data Origin"}, {"customer_key", "Customer Key"}, {"date_key", "Date Key"}, {"month", "Month"}, {"login_flag", "Login Flag"}, {"mobile_flag", "Mobile Flag"}}) in Renamed
