let Source = SyntheticCsv("dim_campaign.csv", {"campaign_id", "campaign_name", "campaign_type", "channel", "target_service", "campaign_key", "synthetic_data_flag", "data_origin"}, {{"campaign_id", type text}, {"campaign_name", type text}, {"campaign_type", type text}, {"channel", type text}, {"target_service", type text}, {"campaign_key", Int64.Type}, {"synthetic_data_flag", type logical}, {"data_origin", type text}}), Renamed = Table.RenameColumns(Source, {{"campaign_id", "Campaign Id"}, {"campaign_name", "Campaign Name"}, {"campaign_type", "Campaign Type"}, {"channel", "Channel"}, {"target_service", "Target Service"}, {"campaign_key", "Campaign Key"}, {"synthetic_data_flag", "Synthetic Data Flag"}, {"data_origin", "Data Origin"}}) in Renamed
