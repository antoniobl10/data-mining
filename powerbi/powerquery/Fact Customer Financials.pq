let
    Source = GoldCsv("fact_customer_financials.csv", {"customer_key", "country_key", "age_group_key", "credit_band_key", "tenure_band_key", "age", "balance", "estimated_salary", "credit_score", "tenure", "customer_value_score", "source_batch_id", "is_high_value", "is_high_balance", "is_high_income", "is_affluent", "is_high_credit_quality", "is_long_tenure", "value_component_balance", "value_component_estimated_salary", "value_component_tenure", "value_component_credit_score", "is_balance_outlier", "is_salary_outlier", "is_credit_score_outlier", "is_age_outlier"}, {{"customer_key", Int64.Type}, {"country_key", Int64.Type}, {"age_group_key", Int64.Type}, {"credit_band_key", Int64.Type}, {"tenure_band_key", Int64.Type}, {"age", Int64.Type}, {"balance", type number}, {"estimated_salary", type number}, {"credit_score", Int64.Type}, {"tenure", Int64.Type}, {"customer_value_score", type number}, {"source_batch_id", type text}, {"is_high_value", type logical}, {"is_high_balance", type logical}, {"is_high_income", type logical}, {"is_affluent", type logical}, {"is_high_credit_quality", type logical}, {"is_long_tenure", type logical}, {"value_component_balance", type number}, {"value_component_estimated_salary", type number}, {"value_component_tenure", type number}, {"value_component_credit_score", type number}, {"is_balance_outlier", type logical}, {"is_salary_outlier", type logical}, {"is_credit_score_outlier", type logical}, {"is_age_outlier", type logical}}),
    Renamed = Table.RenameColumns(Source, {{"customer_key", "Customer Key"}, {"country_key", "Country Key"}, {"age_group_key", "Age Group Key"}, {"credit_band_key", "Credit Band Key"}, {"tenure_band_key", "Tenure Band Key"}, {"age", "Age"}, {"balance", "Balance"}, {"estimated_salary", "Estimated Salary"}, {"credit_score", "Credit Score"}, {"tenure", "Tenure"}, {"customer_value_score", "Customer Value Score"}, {"source_batch_id", "Source Batch Id"}, {"is_high_value", "High Value Flag"}, {"is_high_balance", "High Balance Flag"}, {"is_high_income", "High Income Flag"}, {"is_affluent", "Affluent Flag"}, {"is_high_credit_quality", "High Credit Quality Flag"}, {"is_long_tenure", "Long Tenure Flag"}, {"value_component_balance", "Value Component Balance"}, {"value_component_estimated_salary", "Value Component Estimated Salary"}, {"value_component_tenure", "Value Component Tenure"}, {"value_component_credit_score", "Value Component Credit Score"}, {"is_balance_outlier", "Is Balance Outlier"}, {"is_salary_outlier", "Is Salary Outlier"}, {"is_credit_score_outlier", "Is Credit Score Outlier"}, {"is_age_outlier", "Is Age Outlier"}})
