let Source = SyntheticCsv("dim_product.csv", {"product_type", "product_key", "product_category", "synthetic_data_flag", "data_origin"}, {{"product_type", type text}, {"product_key", Int64.Type}, {"product_category", type text}, {"synthetic_data_flag", type logical}, {"data_origin", type text}}), Renamed = Table.RenameColumns(Source, {{"product_type", "Product Type"}, {"product_key", "Product Key"}, {"product_category", "Product Category"}, {"synthetic_data_flag", "Synthetic Data Flag"}, {"data_origin", "Data Origin"}}) in Renamed
