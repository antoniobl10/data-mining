let Source = AnalyticsCsv("mart_retention_segments.csv", {"cohort_type", "cohort_name", "months_since_cohort", "customer_value_segment", "customers", "retained_customers", "retention_rate", "synthetic_data_flag", "data_origin"}, {{"cohort_type", type text}, {"cohort_name", type text}, {"months_since_cohort", Int64.Type}, {"customer_value_segment", type text}, {"customers", Int64.Type}, {"retained_customers", Int64.Type}, {"retention_rate", type number}, {"synthetic_data_flag", type logical}, {"data_origin", type text}}), Renamed = Table.RenameColumns(Source, {{"cohort_type", "Cohort Type"}, {"cohort_name", "Cohort Name"}, {"months_since_cohort", "Months Since Cohort"}, {"customer_value_segment", "Customer Value Segment"}, {"customers", "Customers"}, {"retained_customers", "Retained Customers"}, {"retention_rate", "Retention Rate"}, {"synthetic_data_flag", "Synthetic Data Flag"}, {"data_origin", "Data Origin"}}) in Renamed
