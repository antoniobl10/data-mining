let Source = AnalyticsCsv("mart_experiment_economics.csv", {"experiment_id", "experiment_name", "treatment_campaign_cost", "control_campaign_cost", "incremental_contact_cost", "incremental_conversions", "incremental_value_proxy", "cost_per_incremental_conversion", "incremental_roi_proxy", "experiment_decision", "interpretation", "synthetic_data_flag", "data_origin"}, {{"experiment_id", type text}, {"experiment_name", type text}, {"treatment_campaign_cost", type number}, {"control_campaign_cost", type number}, {"incremental_contact_cost", type number}, {"incremental_conversions", type number}, {"incremental_value_proxy", type number}, {"cost_per_incremental_conversion", type number}, {"incremental_roi_proxy", type number}, {"experiment_decision", type text}, {"interpretation", type text}, {"synthetic_data_flag", type logical}, {"data_origin", type text}}), Renamed = Table.RenameColumns(Source, {{"experiment_id", "Experiment Id"}, {"experiment_name", "Experiment Name"}, {"treatment_campaign_cost", "Treatment Campaign Cost"}, {"control_campaign_cost", "Control Campaign Cost"}, {"incremental_contact_cost", "Incremental Contact Cost"}, {"incremental_conversions", "Incremental Conversions"}, {"incremental_value_proxy", "Incremental Value Proxy"}, {"cost_per_incremental_conversion", "Cost Per Incremental Conversion"}, {"incremental_roi_proxy", "Incremental Roi Proxy"}, {"experiment_decision", "Experiment Decision"}, {"interpretation", "Interpretation"}, {"synthetic_data_flag", "Synthetic Data Flag"}, {"data_origin", "Data Origin"}}) in Renamed
