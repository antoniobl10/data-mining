let Source = AnalyticsCsv("mart_customer_journeys.csv", {"journey_path", "customers", "sessions", "conversions", "average_steps", "average_duration", "conversion_rate", "synthetic_data_flag", "data_origin"}, {{"journey_path", type text}, {"customers", Int64.Type}, {"sessions", Int64.Type}, {"conversions", Int64.Type}, {"average_steps", type number}, {"average_duration", type number}, {"conversion_rate", type number}, {"synthetic_data_flag", type logical}, {"data_origin", type text}}), Renamed = Table.RenameColumns(Source, {{"journey_path", "Journey Path"}, {"customers", "Customers"}, {"sessions", "Sessions"}, {"conversions", "Conversions"}, {"average_steps", "Average Steps"}, {"average_duration", "Average Duration"}, {"conversion_rate", "Conversion Rate"}, {"synthetic_data_flag", "Synthetic Data Flag"}, {"data_origin", "Data Origin"}}) in Renamed
