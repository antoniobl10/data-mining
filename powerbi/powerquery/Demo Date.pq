let Source = SyntheticCsv("dim_date.csv", {"date", "date_key", "year", "quarter", "month", "month_name", "month_number", "week", "day", "day_of_week", "is_weekend", "synthetic_data_flag", "data_origin"}, {{"date", type date}, {"date_key", Int64.Type}, {"year", Int64.Type}, {"quarter", Int64.Type}, {"month", type text}, {"month_name", type text}, {"month_number", Int64.Type}, {"week", Int64.Type}, {"day", Int64.Type}, {"day_of_week", Int64.Type}, {"is_weekend", type logical}, {"synthetic_data_flag", type logical}, {"data_origin", type text}}), Renamed = Table.RenameColumns(Source, {{"date", "Date"}, {"date_key", "Date Key"}, {"year", "Year"}, {"quarter", "Quarter"}, {"month", "Month"}, {"month_name", "Month Name"}, {"month_number", "Month Number"}, {"week", "Week"}, {"day", "Day"}, {"day_of_week", "Day Of Week"}, {"is_weekend", "Is Weekend"}, {"synthetic_data_flag", "Synthetic Data Flag"}, {"data_origin", "Data Origin"}}) in Renamed
