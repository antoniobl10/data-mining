	partition 'AN Funnels' = m
		mode: import
		source = let Source = AnalyticsCsv("mart_funnel_performance.csv", {"funnel_name", "stage", "stage_order", "customers", "observations", "previous_stage_customers", "conversion_from_previous", "conversion_from_start", "drop_off", "drop_off_rate", "date_period", "segment", "segment_dimension", "small_sample", "synthetic_data_flag", "data_origin"}, {{"funnel_name", type text}, {"stage", type text}, {"stage_order", Int64.Type}, {"customers", Int64.Type}, {"observations", Int64.Type}, {"previous_stage_customers", type number}, {"conversion_from_previous", type number}, {"conversion_from_start", type number}, {"drop_off", Int64.Type}, {"drop_off_rate", type number}, {"date_period", type text}, {"segment", type text}, {"segment_dimension", type text}, {"small_sample", type logical}, {"synthetic_data_flag", type logical}, {"data_origin", type text}}), Renamed = Table.RenameColumns(Source, {{"funnel_name", "Funnel Name"}, {"stage", "Stage"}, {"stage_order", "Stage Order"}, {"customers", "Customers"}, {"observations", "Observations"}, {"previous_stage_customers", "Previous Stage Customers"}, {"conversion_from_previous", "Conversion From Previous"}, {"conversion_from_start", "Conversion From Start"}, {"drop_off", "Drop Off"}, {"drop_off_rate", "Drop Off Rate"}, {"date_period", "Date Period"}, {"segment", "Segment"}, {"segment_dimension", "Segment Dimension"}, {"small_sample", "Small Sample"}, {"synthetic_data_flag", "Synthetic Data Flag"}, {"data_origin", "Data Origin"}}) in Renamed

