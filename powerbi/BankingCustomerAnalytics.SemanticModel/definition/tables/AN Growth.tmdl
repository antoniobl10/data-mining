/// SYNTHETIC DEMO ANALYTICS. Aggregate analytical grains require scoped measures; no real bank results.
table 'AN Growth'

	/// SYNTHETIC DEMO ANALYTICS. mart_growth_summary.customers
	column Customers
		dataType: int64
		summarizeBy: none
		sourceColumn: Customers

	/// SYNTHETIC DEMO ANALYTICS. mart_growth_summary.likely_primary_bank_rate
	column 'Likely Primary Bank Rate'
		dataType: double
		summarizeBy: none
		sourceColumn: Likely Primary Bank Rate

	/// SYNTHETIC DEMO ANALYTICS. mart_growth_summary.salary_domiciliation_rate
	column 'Salary Domiciliation Rate'
		dataType: double
		summarizeBy: none
		sourceColumn: Salary Domiciliation Rate

	/// SYNTHETIC DEMO ANALYTICS. mart_growth_summary.service_activation_rate
	column 'Service Activation Rate'
		dataType: double
		summarizeBy: none
		sourceColumn: Service Activation Rate

	/// SYNTHETIC DEMO ANALYTICS. mart_growth_summary.nps
	column Nps
		dataType: double
		summarizeBy: none
		sourceColumn: Nps

	/// SYNTHETIC DEMO ANALYTICS. mart_growth_summary.high_value_low_engagement_customers
	column 'High Value Low Engagement Customers'
		dataType: int64
		summarizeBy: none
		sourceColumn: High Value Low Engagement Customers

	/// SYNTHETIC DEMO ANALYTICS. mart_growth_summary.high_value_low_engagement_balance_share
	column 'High Value Low Engagement Balance Share'
		dataType: double
		summarizeBy: none
		sourceColumn: High Value Low Engagement Balance Share

	/// SYNTHETIC DEMO ANALYTICS. mart_growth_summary.observed_campaign_roi_proxy
	column 'Observed Campaign Roi Proxy'
		dataType: double
		summarizeBy: none
		sourceColumn: Observed Campaign Roi Proxy

	/// SYNTHETIC DEMO ANALYTICS. mart_growth_summary.synthetic_data_flag
	column 'Synthetic Data Flag'
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: Synthetic Data Flag

	/// SYNTHETIC DEMO ANALYTICS. mart_growth_summary.data_origin
	column 'Data Origin'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Data Origin

	partition 'AN Growth' = m
		mode: import
		source = let Source = AnalyticsCsv("mart_growth_summary.csv", {"customers", "likely_primary_bank_rate", "salary_domiciliation_rate", "service_activation_rate", "nps", "high_value_low_engagement_customers", "high_value_low_engagement_balance_share", "observed_campaign_roi_proxy", "synthetic_data_flag", "data_origin"}, {{"customers", Int64.Type}, {"likely_primary_bank_rate", type number}, {"salary_domiciliation_rate", type number}, {"service_activation_rate", type number}, {"nps", type number}, {"high_value_low_engagement_customers", Int64.Type}, {"high_value_low_engagement_balance_share", type number}, {"observed_campaign_roi_proxy", type number}, {"synthetic_data_flag", type logical}, {"data_origin", type text}}), Renamed = Table.RenameColumns(Source, {{"customers", "Customers"}, {"likely_primary_bank_rate", "Likely Primary Bank Rate"}, {"salary_domiciliation_rate", "Salary Domiciliation Rate"}, {"service_activation_rate", "Service Activation Rate"}, {"nps", "Nps"}, {"high_value_low_engagement_customers", "High Value Low Engagement Customers"}, {"high_value_low_engagement_balance_share", "High Value Low Engagement Balance Share"}, {"observed_campaign_roi_proxy", "Observed Campaign Roi Proxy"}, {"synthetic_data_flag", "Synthetic Data Flag"}, {"data_origin", "Data Origin"}}) in Renamed

