	partition 'AN Cohorts' = m
		mode: import
		source = let Source = AnalyticsCsv("mart_customer_cohorts.csv", {"cohort_type", "cohort_name", "cohort_period", "activity_period", "months_since_cohort", "customers", "active_customers", "retained_customers", "average_products", "average_engagement_score", "current_value_proxy", "product_retained_customers", "retention_rate", "retention_definition", "product_retention_rate", "service_retention_rate", "average_balance", "small_sample", "synthetic_data_flag", "data_origin"}, {{"cohort_type", type text}, {"cohort_name", type text}, {"cohort_period", type text}, {"activity_period", type text}, {"months_since_cohort", Int64.Type}, {"customers", Int64.Type}, {"active_customers", Int64.Type}, {"retained_customers", Int64.Type}, {"average_products", type number}, {"average_engagement_score", type number}, {"current_value_proxy", type number}, {"product_retained_customers", Int64.Type}, {"retention_rate", type number}, {"retention_definition", type text}, {"product_retention_rate", type number}, {"service_retention_rate", type number}, {"average_balance", type number}, {"small_sample", type logical}, {"synthetic_data_flag", type logical}, {"data_origin", type text}}), Renamed = Table.RenameColumns(Source, {{"cohort_type", "Cohort Type"}, {"cohort_name", "Cohort Name"}, {"cohort_period", "Cohort Period"}, {"activity_period", "Activity Period"}, {"months_since_cohort", "Months Since Cohort"}, {"customers", "Customers"}, {"active_customers", "Active Customers"}, {"retained_customers", "Retained Customers"}, {"average_products", "Average Products"}, {"average_engagement_score", "Average Engagement Score"}, {"current_value_proxy", "Current Value Proxy"}, {"product_retained_customers", "Product Retained Customers"}, {"retention_rate", "Retention Rate"}, {"retention_definition", "Retention Definition"}, {"product_retention_rate", "Product Retention Rate"}, {"service_retention_rate", "Service Retention Rate"}, {"average_balance", "Average Balance"}, {"small_sample", "Small Sample"}, {"synthetic_data_flag", "Synthetic Data Flag"}, {"data_origin", "Data Origin"}}) in Renamed

