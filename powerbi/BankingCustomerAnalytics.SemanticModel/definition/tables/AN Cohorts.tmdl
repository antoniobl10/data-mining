/// SYNTHETIC DEMO ANALYTICS. Aggregate analytical grains require scoped measures; no real bank results.
table 'AN Cohorts'

	/// SYNTHETIC DEMO ANALYTICS. mart_customer_cohorts.cohort_type
	column 'Cohort Type'
		dataType: string
		summarizeBy: none
