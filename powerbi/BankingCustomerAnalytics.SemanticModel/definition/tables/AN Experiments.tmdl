/// SYNTHETIC DEMO ANALYTICS. Aggregate analytical grains require scoped measures; no real bank results.
table 'AN Experiments'

	/// SYNTHETIC DEMO ANALYTICS. mart_experiment_results.control_conversion_rate
	column 'Control Conversion Rate'
		dataType: double
		summarizeBy: none
