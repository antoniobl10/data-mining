/// SYNTHETIC DEMO MODEL; offline held-out test metrics; disconnected from customer filters
table 'ML Model Performance'

	/// SYNTHETIC DEMO MODEL. model_performance.use_case
	column 'Use Case'
		dataType: string
		summarizeBy: none
		sourceColumn: Use Case

	/// SYNTHETIC DEMO MODEL. model_performance.model_name
	column 'Model Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Model Name

	/// SYNTHETIC DEMO MODEL. model_performance.model_version
	column 'Model Version'
		dataType: string
		summarizeBy: none
		sourceColumn: Model Version

	/// SYNTHETIC DEMO MODEL. model_performance.evaluation_type
	column 'Evaluation Type'
		dataType: string
		summarizeBy: none
		sourceColumn: Evaluation Type

	/// SYNTHETIC DEMO MODEL. model_performance.data_origin
	column 'Data Origin'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Data Origin

	/// SYNTHETIC DEMO MODEL. model_performance.roc_auc
	column 'Roc Auc'
		dataType: double
		summarizeBy: none
		sourceColumn: Roc Auc

	/// SYNTHETIC DEMO MODEL. model_performance.pr_auc
	column 'Pr Auc'
		dataType: double
		summarizeBy: none
		sourceColumn: Pr Auc

	/// SYNTHETIC DEMO MODEL. model_performance.precision
	column Precision
		dataType: double
		summarizeBy: none
		sourceColumn: Precision

	/// SYNTHETIC DEMO MODEL. model_performance.recall
	column Recall
		dataType: double
		summarizeBy: none
		sourceColumn: Recall

	/// SYNTHETIC DEMO MODEL. model_performance.f1
	column F1
		dataType: double
		summarizeBy: none
		sourceColumn: F1

	/// SYNTHETIC DEMO MODEL. model_performance.log_loss
	column 'Log Loss'
		dataType: double
		summarizeBy: none
		sourceColumn: Log Loss

	/// SYNTHETIC DEMO MODEL. model_performance.brier_score
	column 'Brier Score'
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: Brier Score

	/// SYNTHETIC DEMO MODEL. model_performance.lift_at_10
	column 'Lift At 10'
		dataType: double
		summarizeBy: none
		sourceColumn: Lift At 10

	/// SYNTHETIC DEMO MODEL. model_performance.recall_at_top_5
	column 'Recall At Top 5'
		dataType: double
		summarizeBy: none
		sourceColumn: Recall At Top 5

	/// SYNTHETIC DEMO MODEL. model_performance.recall_at_top_10
	column 'Recall At Top 10'
		dataType: double
		summarizeBy: none
		sourceColumn: Recall At Top 10

	/// SYNTHETIC DEMO MODEL. model_performance.calibration
	column Calibration
		dataType: string
		summarizeBy: none
		sourceColumn: Calibration

	/// SYNTHETIC DEMO MODEL. model_performance.test_start
	column 'Test Start'
		dataType: string
		summarizeBy: none
		sourceColumn: Test Start

	/// SYNTHETIC DEMO MODEL. model_performance.test_end
	column 'Test End'
		dataType: string
		summarizeBy: none
		sourceColumn: Test End

	partition 'ML Model Performance' = m
		mode: import
		source = let Source = MLCsv("model_performance.csv", {"use_case", "model_name", "model_version", "evaluation_type", "data_origin", "roc_auc", "pr_auc", "precision", "recall", "f1", "log_loss", "brier_score", "lift_at_10", "recall_at_top_5", "recall_at_top_10", "calibration", "test_start", "test_end"}, {{"use_case", type text}, {"model_name", type text}, {"model_version", type text}, {"evaluation_type", type text}, {"data_origin", type text}, {"roc_auc", type number}, {"pr_auc", type number}, {"precision", type number}, {"recall", type number}, {"f1", type number}, {"log_loss", type number}, {"brier_score", type number}, {"lift_at_10", type number}, {"recall_at_top_5", type number}, {"recall_at_top_10", type number}, {"calibration", type text}, {"test_start", type text}, {"test_end", type text}}), Renamed = Table.RenameColumns(Source, {{"use_case", "Use Case"}, {"model_name", "Model Name"}, {"model_version", "Model Version"}, {"evaluation_type", "Evaluation Type"}, {"data_origin", "Data Origin"}, {"roc_auc", "Roc Auc"}, {"pr_auc", "Pr Auc"}, {"precision", "Precision"}, {"recall", "Recall"}, {"f1", "F1"}, {"log_loss", "Log Loss"}, {"brier_score", "Brier Score"}, {"lift_at_10", "Lift At 10"}, {"recall_at_top_5", "Recall At Top 5"}, {"recall_at_top_10", "Recall At Top 10"}, {"calibration", "Calibration"}, {"test_start", "Test Start"}, {"test_end", "Test End"}}) in Renamed

