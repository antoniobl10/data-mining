	partition 'Dim Customer' = m
		mode: import
		source =
				let
				    Source = GoldCsv("dim_customer.csv", {"customer_key", "customer_id", "country_key", "age_group_key", "credit_band_key", "tenure_band_key", "gender", "age", "tenure", "credit_score", "balance", "estimated_salary", "balance_band", "salary_band", "customer_value_score", "customer_value_segment", "primary_customer_segment", "data_quality_status", "data_quality_issue_count", "is_high_value", "is_high_balance", "is_high_income", "is_affluent", "is_high_credit_quality", "is_long_tenure"}, {{"customer_key", Int64.Type}, {"customer_id", type text}, {"country_key", Int64.Type}, {"age_group_key", Int64.Type}, {"credit_band_key", Int64.Type}, {"tenure_band_key", Int64.Type}, {"gender", type text}, {"age", Int64.Type}, {"tenure", Int64.Type}, {"credit_score", Int64.Type}, {"balance", type number}, {"estimated_salary", type number}, {"balance_band", type text}, {"salary_band", type text}, {"customer_value_score", type number}, {"customer_value_segment", type text}, {"primary_customer_segment", type text}, {"data_quality_status", type text}, {"data_quality_issue_count", Int64.Type}, {"is_high_value", type logical}, {"is_high_balance", type logical}, {"is_high_income", type logical}, {"is_affluent", type logical}, {"is_high_credit_quality", type logical}, {"is_long_tenure", type logical}}),
				    Renamed = Table.RenameColumns(Source, {{"customer_key", "Customer Key"}, {"customer_id", "Customer ID"}, {"country_key", "Country Key"}, {"age_group_key", "Age Group Key"}, {"credit_band_key", "Credit Band Key"}, {"tenure_band_key", "Tenure Band Key"}, {"gender", "Gender"}, {"age", "Age"}, {"tenure", "Tenure"}, {"credit_score", "Credit Score"}, {"balance", "Balance"}, {"estimated_salary", "Estimated Salary"}, {"balance_band", "Balance Band"}, {"salary_band", "Salary Band"}, {"customer_value_score", "Customer Value Score"}, {"customer_value_segment", "Customer Value Segment"}, {"primary_customer_segment", "Primary Customer Segment"}, {"data_quality_status", "Data Quality Status"}, {"data_quality_issue_count", "Data Quality Issue Count"}, {"is_high_value", "High Value Flag"}, {"is_high_balance", "High Balance Flag"}, {"is_high_income", "High Income Flag"}, {"is_affluent", "Affluent Flag"}, {"is_high_credit_quality", "High Credit Quality Flag"}, {"is_long_tenure", "Long Tenure Flag"}}),
				    Sorted = Table.AddColumn(Renamed, "Customer Value Sort", each if [Customer Value Segment] = "Unknown" then 5 else List.PositionOf({"Low", "Medium", "High", "Premium"}, [Customer Value Segment]) + 1, Int64.Type)
				in Sorted

